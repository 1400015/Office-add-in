{
  "name": "office-universal-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Universal AI assistant add-in for Microsoft Word, Excel and PowerPoint",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "office-addin-dev-certs install && office-addin-dev-certs verify && vite --port 3000",
    "stop": "office-addin-dev-certs uninstall",
    "validate": "office-addin-manifest validate manifest.xml",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "sideload": "office-addin-debugging start manifest.xml desktop"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.75.0",
    "@fluentui/react-icons": "^2.0.270",
    "i18next": "^26.5.12",
    "idb": "^8.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/office-js": "^1.0.615",
    "@types/office-runtime": "^1.0.35",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "office-addin-cli": "^1.6.2",
    "office-addin-debugging": "^5.1.4",
    "office-addin-dev-certs": "^1.13.3",
    "office-addin-lint": "^2.3.2",
    "office-addin-manifest": "^1.13.2",
    "prettier": "^3.4.1",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
