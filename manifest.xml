<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides/1.0"
  xsi:type="TaskPaneApp">

  <Id>9caac65c-1af4-4c1f-a347-4ad85a2a09fd</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Office Universal AI</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="AI Assistant"/>
  <Description DefaultValue="Universal AI assistant for Microsoft Word, Excel and PowerPoint with multi-provider support."/>
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://localhost:3000/"/>

  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document"/>
    <Host Name="Workbook"/>
    <Host Name="Presentation"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="SharedRuntime" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="VersionOverridesV1_1">

    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="AI.Group" label="AI Assistant">
                <Control xsi:type="Button" id="AI.OpenChat">
                  <Label resid="AI.OpenChat.Label"/>
                  <Supertip>
                    <Title resid="AI.OpenChat.Label"/>
                    <Description resid="AI.OpenChat.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16.Url"/>
                    <bt:Image size="32" resid="Icon32.Url"/>
                    <bt:Image size="80" resid="Icon80.Url"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="AI.Summarize">
                  <Label resid="AI.Summarize.Label"/>
                  <Supertip>
                    <Title resid="AI.Summarize.Label"/>
                    <Description resid="AI.Summarize.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16.Url"/>
                    <bt:Image size="32" resid="Icon32.Url"/>
                    <bt:Image size="80" resid="Icon80.Url"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction" Action="Summarize"/>
                </Control>
                <Control xsi:type="Button" id="AI.Translate">
                  <Label resid="AI.Translate.Label"/>
                  <Supertip>
                    <Title resid="AI.Translate.Label"/>
                    <Description resid="AI.Translate.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16.Url"/>
                    <bt:Image size="32" resid="Icon32.Url"/>
                    <bt:Image size="80" resid="Icon80.Url"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction" Action="Translate"/>
                </Control>
                <Control xsi:type="Button" id="AI.Analyse">
                  <Label resid="AI.Analyse.Label"/>
                  <Supertip>
                    <Title resid="AI.Analyse.Label"/>
                    <Description resid="AI.Analyse.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16.Url"/>
                    <bt:Image size="32" resid="Icon32.Url"/>
                    <bt:Image size="80" resid="Icon80.Url"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction" Action="Analyse"/>
                </Control>
                <Control xsi:type="Button" id="AI.Settings">
                  <Label resid="AI.Settings.Label"/>
                  <Supertip>
                    <Title resid="AI.Settings.Label"/>
                    <Description resid="AI.Settings.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16.Url"/>
                    <bt:Image size="32" resid="Icon32.Url"/>
                    <bt:Image size="80" resid="Icon80.Url"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Settings.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>

      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="AI.Group" label="AI Assistant">
                <Control xsi:type="Button" id="AI.OpenChat">
                  <Label resid="AI.OpenChat.Label"/>
                  <Supertip>
                    <Title resid="AI.OpenChat.Label"/>
                    <Description resid="AI.OpenChat.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16.Url"/>
                    <bt:Image size="32" resid="Icon32.Url"/>
                    <bt:Image size="80" resid="Icon80.Url"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="AI.Summarize">
                  <Label resid="AI.Summarize.Label"/>
                  <Supertip>
                    <Title resid="AI.Summarize.Label"/>
                    <Description resid="AI.Summarize.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16.Url"/>
                    <bt:Image size="32" resid="Icon32.Url"/>
                    <bt:Image size="80" resid="Icon80.Url"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction" Action="Summarize"/>
                </Control>
                <Control xsi:type="Button" id="AI.Translate">
                  <Label resid="AI.Translate.Label"/>
                  <Supertip>
                    <Title resid="AI.Translate.Label"/>
                    <Description resid="AI.Translate.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16.Url"/>
                    <bt:Image size="32" resid="Icon32.Url"/>
                    <bt:Image size="80" resid="Icon80.Url"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction" Action="Translate"/>
                </Control>
                <Control xsi:type="Button" id="AI.Analyse">
                  <Label resid="AI.Analyse.Label"/>
                  <Supertip>
                    <Title resid="AI.Analyse.Label"/>
                    <Description resid="AI.Analyse.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16.Url"/>
                    <bt:Image size="32" resid="Icon32.Url"/>
                    <bt:Image size="80" resid="Icon80.Url"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction" Action="Analyse"/>
                </Control>
                <Control xsi:type="Button" id="AI.Settings">
                  <Label resid="AI.Settings.Label"/>
                  <Supertip>
                    <Title resid="AI.Settings.Label"/>
                    <Description resid="AI.Settings.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16.Url"/>
                    <bt:Image size="32" resid="Icon32.Url"/>
                    <bt:Image size="80" resid="Icon80.Url"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Settings.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>

      <Host xsi:type="Presentation">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="AI.Group" label="AI Assistant">
                <Control xsi:type="Button" id="AI.OpenChat">
                  <Label resid="AI.OpenChat.Label"/>
                  <Supertip>
                    <Title resid="AI.OpenChat.Label"/>
                    <Description resid="AI.OpenChat.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16.Url"/>
                    <bt:Image size="32" resid="Icon32.Url"/>
                    <bt:Image size="80" resid="Icon80.Url"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="AI.Summarize">
                  <Label resid="AI.Summarize.Label"/>
                  <Supertip>
                    <Title resid="AI.Summarize.Label"/>
                    <Description resid="AI.Summarize.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16.Url"/>
                    <bt:Image size="32" resid="Icon32.Url"/>
                    <bt:Image size="80" resid="Icon80.Url"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction" Action="Summarize"/>
                </Control>
                <Control xsi:type="Button" id="AI.Translate">
                  <Label resid="AI.Translate.Label"/>
                  <Supertip>
                    <Title resid="AI.Translate.Label"/>
                    <Description resid="AI.Translate.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16.Url"/>
                    <bt:Image size="32" resid="Icon32.Url"/>
                    <bt:Image size="80" resid="Icon80.Url"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction" Action="Translate"/>
                </Control>
                <Control xsi:type="Button" id="AI.Analyse">
                  <Label resid="AI.Analyse.Label"/>
                  <Supertip>
                    <Title resid="AI.Analyse.Label"/>
                    <Description resid="AI.Analyse.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16.Url"/>
                    <bt:Image size="32" resid="Icon32.Url"/>
                    <bt:Image size="80" resid="Icon80.Url"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction" Action="Analyse"/>
                </Control>
                <Control xsi:type="Button" id="AI.Settings">
                  <Label resid="AI.Settings.Label"/>
                  <Supertip>
                    <Title resid="AI.Settings.Label"/>
                    <Description resid="AI.Settings.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16.Url"/>
                    <bt:Image size="32" resid="Icon32.Url"/>
                    <bt:Image size="80" resid="Icon80.Url"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Settings.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Requirements>
      <Sets>
        <Set Name="SharedRuntime" MinVersion="1.1"/>
      </Sets>
    </Requirements>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon16.Url" DefaultValue="https://localhost:3000/assets/icon-16.png"/>
        <bt:Image id="Icon32.Url" DefaultValue="https://localhost:3000/assets/icon-32.png"/>
        <bt:Image id="Icon64.Url" DefaultValue="https://localhost:3000/assets/icon-64.png"/>
        <bt:Image id="Icon80.Url" DefaultValue="https://localhost:3000/assets/icon-80.png"/>
        <bt:Image id="Icon128.Url" DefaultValue="https://localhost:3000/assets/icon-128.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3000/"/>
        <bt:Url id="Settings.Url" DefaultValue="https://localhost:3000/?view=settings"/>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="AI.OpenChat.Label" DefaultValue="Open Chat"/>
        <bt:String id="AI.Summarize.Label" DefaultValue="Summarize"/>
        <bt:String id="AI.Translate.Label" DefaultValue="Translate"/>
        <bt:String id="AI.Analyse.Label" DefaultValue="Analyse"/>
        <bt:String id="AI.Settings.Label" DefaultValue="Settings"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="AI.OpenChat.Description" DefaultValue="Open the AI chat assistant."/>
        <bt:String id="AI.Summarize.Description" DefaultValue="Summarize the current document, selection or slide."/>
        <bt:String id="AI.Translate.Description" DefaultValue="Translate the current selection."/>
        <bt:String id="AI.Analyse.Description" DefaultValue="Analyse the current document, range or presentation."/>
        <bt:String id="AI.Settings.Description" DefaultValue="Open the add-in settings."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
